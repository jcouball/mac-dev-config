Host sophon
  HostName 192.168.0.199
  User james
  IdentityFile ~/.ssh/id_ed25519_sophon
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  ForwardAgent no
  # sophon runs OpenSSH for Windows 9.5, which offers no post-quantum key
  # exchange. Accepted on the LAN; this silences only that warning.
  WarnWeakCrypto no-pq-kex
  UseKeychain yes
  AddKeysToAgent yes
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m

Host rama
  User james
  IdentityFile ~/.ssh/id_ed25519_rama
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  ForwardAgent no
  UseKeychain yes
  AddKeysToAgent yes
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m

Host neuromancer
  HostName neuromancer.local
  User james
  IdentityFile ~/.ssh/id_ed25519_neuromancer
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  ForwardAgent no
  # sshd on the Macs admits IPv4 addresses on the LAN only (sshd-mac.conf), and
  # a .local name also resolves to IPv6 link-local addresses.
  AddressFamily inet
  UseKeychain yes
  AddKeysToAgent yes
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m

Host cortex
  HostName cortex.local
  User james
  IdentityFile ~/.ssh/id_ed25519_cortex
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  ForwardAgent no
  # As for neuromancer: IPv4 only.
  AddressFamily inet
  UseKeychain yes
  AddKeysToAgent yes
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m

Host 192.168.2.1
  User root
  IdentityFile ~/.ssh/id_rsa_proxmox_admin

Host 192.168.2.101
  User root
  IdentityFile ~/.ssh/id_rsa_cloudflared_admin

Host *
  ForwardAgent yes
  KeepAlive yes
  ServerAliveInterval 60
  StrictHostKeyChecking no
  CASignatureAlgorithms +ssh-rsa
  Protocol 2
  AddKeysToAgent yes
  UseKeychain yes
